+                rpassword::prompt_password(format!("Type plan id '{}' to approve: ", plan.id))
+                    .map_err(|_| {
+                        MailError::new(
+                            MailErrorCode::InvalidInput,
+                            "cannot read approval from the terminal",
+                            false,

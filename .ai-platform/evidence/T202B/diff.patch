+        }
+        "effect_invocations" => {
+            "INSERT INTO effect_invocations VALUES
+             (zeroblob(16),zeroblob(16),zeroblob(16),zeroblob(16),x'01',zeroblob(32),1)"
+        }
+        "effect_observations" => {

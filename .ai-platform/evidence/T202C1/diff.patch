+        receipt_id: uuid_from_blob_sql(row.get(1)?)?,
+        action,
+        target_kind,
+        target_id: row.get(4)?,
+        manifest_sha256: digest_from_blob_sql(row.get(5)?)?,
+        use_receipt: row.get(6)?,

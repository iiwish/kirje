    <section id="faq" class="py-20 px-4 sm:px-6 max-w-4xl mx-auto border-t border-white/[0.06]">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-4xl font-bold text-white mb-3" data-i18n data-zh="常见问题 (FAQ)" data-en="Frequently Asked Questions">常见问题 (FAQ)</h2>
        <p class="text-zinc-400 text-sm sm:text-base" data-i18n data-zh="关于安全性、国内邮箱授权码与离线能力的解答。" data-en="Answers about security boundaries, app passwords, and offline sync.">关于安全性、国内邮箱授权码与离线能力的解答。</p>
      </div>

      <div class="space-y-3">
        <details class="bento-card rounded-2xl p-5 group" open>
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-white text-sm sm:text-base">
            <span data-i18n data-zh="为什么 163 / QQ 邮箱需要用「授权码」而不是登录密码？" data-en="Why do 163 / QQ / iCloud require an app password instead of my login password?">为什么 163 / QQ 邮箱需要用「授权码」而不是登录密码？</span>
            <span class="text-zinc-400 group-open:rotate-45 transition-transform font-mono text-lg">+</span>
          </summary>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed" data-i18n data-zh="主流邮箱服务商（网易 163/126、QQ、iCloud、Fastmail 等）出于安全策略，已全面禁止第三方客户端直接使用网页主密码连接 IMAP/SMTP。运行 kirje account discover <你的邮箱> 时，Kirje 会直接告诉你去邮箱网页版哪个菜单生成 16 位专用授权码，一次配置即可长期静默使用。" data-en="Major providers block primary login passwords for third-party IMAP/SMTP clients for your account security. Running kirje account discover <email> gives you the exact menu path to generate a dedicated client app password.">
            主流邮箱服务商（网易 163/126、QQ、iCloud、Fastmail 等）出于安全策略，已全面禁止第三方客户端直接使用网页主密码连接 IMAP/SMTP。运行 <code class="text-emerald-400">kirje account discover &lt;你的邮箱&gt;</code> 时，Kirje 会直接告诉你去邮箱网页版哪个菜单生成 16 位专用授权码，一次配置即可长期静默使用。
          </p>
        </details>

        <details class="bento-card rounded-2xl p-5 group">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-white text-sm sm:text-base">
            <span data-i18n data-zh="其他 Agent 或后台任务调用 Kirje 时，会弹出钥匙串密码框吗？" data-en="Will background agents trigger macOS Keychain password prompts?">其他 Agent 或后台任务调用 Kirje 时，会弹出钥匙串密码框吗？</span>
            <span class="text-zinc-400 group-open:rotate-45 transition-transform font-mono text-lg">+</span>
          </summary>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed" data-i18n data-zh="不会。Kirje 专门设计了基于严格 0600 POSIX 文件权限的 FileSecretStore。配置一次后，无论是 Claude Desktop、Cursor 还是任何后台定时 Agent，都可以零弹窗、静默免登录读取邮箱。" data-en="No. Kirje uses a private FileSecretStore with strict 0600 POSIX permissions, completely eliminating recurring macOS Keychain prompts across all your AI clients and background agents.">
            不会。Kirje 专门设计了基于严格 <code class="text-emerald-400">0600</code> POSIX 文件权限的私有凭证存储。配置一次后，无论是 Claude Desktop、Cursor 还是任何后台定时 Agent，都可以零弹窗、静默免登录读取邮箱。
          </p>
        </details>

        <details class="bento-card rounded-2xl p-5 group">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-white text-sm sm:text-base">
            <span data-i18n data-zh="我的邮件内容或密码会经过 Kirje 服务器吗？" data-en="Do my emails or credentials ever pass through Kirje servers?">我的邮件内容或密码会经过 Kirje 服务器吗？</span>
            <span class="text-zinc-400 group-open:rotate-45 transition-transform font-mono text-lg">+</span>
          </summary>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed" data-i18n data-zh="绝对不会。Kirje 没有云端服务器、没有遥测（Telemetry）、也没有中继服务。你的客户端直接通过 TLS 加密直连你的邮箱服务商，所有索引与账本均保存在本地磁盘的 SQLite 中。" data-en="Never. Kirje has zero cloud servers, zero telemetry, and zero relays. Your machine connects directly to your mail provider over TLS, and all indexes stay in local SQLite files.">
            绝对不会。Kirje 没有云端服务器、没有遥测（Telemetry）、也没有中继服务。你的客户端直接通过 TLS 加密直连你的邮箱服务商，所有索引与账本均保存在本地磁盘的 SQLite 中。
          </p>
        </details>

        <details class="bento-card rounded-2xl p-5 group">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-white text-sm sm:text-base">
            <span data-i18n data-zh="电脑断网时能检索邮件吗？" data-en="Can I search emails while offline?">电脑断网时能检索邮件吗？</span>
            <span class="text-zinc-400 group-open:rotate-45 transition-transform font-mono text-lg">+</span>
          </summary>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed" data-i18n data-zh="可以。运行 kirje sync run 后，邮件元数据与会话关系会事务性写入本地 SQLite 索引库。之后使用 message search-local 或 message thread 完全无需网络连接，也不需要读取凭证。" data-en="Yes. After running kirje sync run, envelope metadata and thread graphs are stored in local SQLite, enabling credential-free, offline search via message search-local.">
            可以。运行 <code class="text-emerald-400">kirje sync run</code> 后，邮件元数据与会话关系会事务性写入本地 SQLite 索引库。之后使用 <code class="text-emerald-400">message search-local</code> 或 <code class="text-emerald-400">message thread</code> 完全无需网络连接，也不需要读取凭证。
          </p>
        </details>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-16 px-4 sm:px-6 max-w-4xl mx-auto text-center">
      <div class="bento-card rounded-3xl p-8 sm:p-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3" data-i18n data-zh="让你的 AI Agent 安全接管收件箱" data-en="Give Your AI Agents Safe Email Access Today">让你的 AI Agent 安全接管收件箱</h2>
        <p class="text-zinc-400 text-sm sm:text-base mb-7 max-w-xl mx-auto" data-i18n data-zh="100% 开源、Rust 驱动、专为本地优先与防 Prompt 注入打造。" data-en="100% open source, Rust-powered, and engineered for local-first safety.">100% 开源、Rust 驱动、专为本地优先与防 Prompt 注入打造。</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="https://github.com/iiwish/kirje" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-xl text-sm font-semibold bg-white text-zinc-950 hover:bg-zinc-200 transition-colors" data-i18n data-zh="前往 GitHub 点亮 Star ★" data-en="Star on GitHub ★">前往 GitHub 点亮 Star ★</a>
          <a href="#quickstart" class="px-6 py-3 rounded-xl text-sm font-medium border border-white/10 bg-zinc-900/70 text-zinc-200 hover:bg-zinc-800 transition-colors" data-i18n data-zh="查看安装命令" data-en="View Install Steps">查看安装命令</a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/[0.06] py-10 px-4 sm:px-6 text-sm text-zinc-500">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-zinc-300">Kirje</span>
        <span>·</span>
        <span data-i18n data-zh="安全、本地优先 AI Agent 邮件引擎" data-en="Safe, Local-First Email Engine for AI Agents">安全、本地优先 AI Agent 邮件引擎</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://github.com/iiwish/kirje" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">GitHub</a>
        <a href="https://github.com/iiwish/kirje/blob/main/docs/agent-guide.md" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">Agent Guide</a>
        <a href="https://github.com/iiwish/kirje/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">Security</a>
        <a href="https://github.com/iiwish/kirje/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">License</a>
      </div>
    </div>
  </footer>

  <script>
    // Spotlight hover effect for bento cards
    document.querySelectorAll<HTMLElement>('.bento-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });

    // Install command tabs
    const installTabs = document.querySelectorAll('.install-tab');
    const installCmdText = document.getElementById('install-cmd-text');
    const copyBtn = document.getElementById('copy-install-btn');

    installTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        installTabs.forEach((t) => {
          t.classList.remove('bg-zinc-800', 'text-white');
          t.classList.add('text-zinc-400');
        });
        tab.classList.add('bg-zinc-800', 'text-white');
        tab.classList.remove('text-zinc-400');
        const cmd = tab.getAttribute('data-cmd');
        if (cmd && installCmdText) {
          installCmdText.textContent = cmd;
        }
      });
    });

    copyBtn?.addEventListener('click', async () => {
      const text = installCmdText?.textContent?.trim();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const orig = copyBtn.textContent;
        const isEn = document.documentElement.lang === 'en';
        copyBtn.textContent = isEn ? 'Copied!' : '已复制!';
        copyBtn.classList.add('text-emerald-400');
        setTimeout(() => {
          copyBtn.textContent = orig;
          copyBtn.classList.remove('text-emerald-400');
        }, 1600);
      } catch {}
    });

    // Interactive Native Dialog Simulation
    const simDialog = document.getElementById('macos-sim-dialog');
    const simOutcome = document.getElementById('sim-outcome');
    const rejectBtn = document.getElementById('sim-reject-btn');
    const approveBtn = document.getElementById('sim-approve-btn');
    const resetBtn = document.getElementById('reset-sim-btn');

    function setOutcome(type: 'pending' | 'rejected' | 'approved') {
      const isEn = document.documentElement.lang === 'en';
      if (!simOutcome || !simDialog) return;

      if (type === 'pending') {
        simDialog.classList.remove('opacity-40', 'scale-95', 'pointer-events-none');
        simOutcome.innerHTML = `<span class="text-amber-400 animate-pulse">${
          isEn
            ? '⏳ Waiting for human approval via native dialog... (Click a button on the dialog)'
            : '⏳ 等待人类在本地系统弹窗确认...（请点击右侧弹窗按钮体验）'
        }</span>`;
      } else if (type === 'rejected') {
        simDialog.classList.add('opacity-40', 'scale-95', 'pointer-events-none');
        simOutcome.innerHTML = `<div class="rounded-lg bg-emerald-950/30 border border-emerald-500/30 p-2.5 text-emerald-300">✓ ${
          isEn
            ? 'Blocked: User rejected send plan. Prompt injection neutralized at physical boundary!'
            : '拦截成功：用户点击「拒绝」，Prompt 注入恶意发信在物理边界被彻底阻断！'
        }</div>`;
      } else {
        simDialog.classList.add('opacity-40', 'scale-95', 'pointer-events-none');
        simOutcome.innerHTML = `<div class="rounded-lg bg-amber-950/30 border border-amber-500/30 p-2.5 text-amber-300">⚡ ${
          isEn
            ? 'Approved: Signed SHA-256 proof and executed SMTP delivery once (audited).'
            : '已授权：生成 SHA-256 签名并执行单次 SMTP 投递，完整记录入本地审计账本。'
        }</div>`;
      }
    }

    rejectBtn?.addEventListener('click', () => setOutcome('rejected'));
    approveBtn?.addEventListener('click', () => setOutcome('approved'));
    resetBtn?.addEventListener('click', () => setOutcome('pending'));

    // Bilingual toggle (ZH / EN)
    const langToggle = document.getElementById('lang-toggle');
    let currentLang = localStorage.getItem('kirje_lang') || 'zh';

    function applyLang(lang: string) {
      document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const text = el.getAttribute(lang === 'en' ? 'data-en' : 'data-zh');
        if (text) {
          el.textContent = text;
        }
      });
      if (langToggle) {
        langToggle.textContent = lang === 'en' ? '中文' : 'EN';
      }
      localStorage.setItem('kirje_lang', lang);
      setOutcome('pending');
    }

    applyLang(currentLang);

    langToggle?.addEventListener('click', () => {
      currentLang = currentLang === 'zh' ? 'en' : 'zh';
      applyLang(currentLang);
    });
  </script>
</Layout>
